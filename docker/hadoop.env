# Configuración de Hadoop. Las variables siguen el formato de las imágenes bde2020:
#   CORE_CONF_*  -> core-site.xml    HDFS_CONF_* -> hdfs-site.xml    YARN_CONF_* -> yarn-site.xml
# En los nombres, "_" separa partes y "___" equivale a un guion "-".

# Dirección de HDFS: todos los servicios hablan con el namenode por este puerto.
CORE_CONF_fs_defaultFS=hdfs://namenode:9000

# Réplicas de cada bloque. Solo hay 1 datanode, así que 1 (en producción serían 3).
HDFS_CONF_dfs_replication=1

# Sin control de permisos: simplifica el trabajo en local (no usar así en producción).
HDFS_CONF_dfs_permissions_enabled=false

# Permite acceso por API web (WebHDFS) y evita problemas de nombres entre contenedores.
HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false

# YARN: dónde está el resourcemanager y cuánta memoria puede usar el nodemanager.
YARN_CONF_yarn_resourcemanager_hostname=resourcemanager
YARN_CONF_yarn_nodemanager_resource_memory___mb=4096
YARN_CONF_yarn_scheduler_maximum___allocation___mb=4096
